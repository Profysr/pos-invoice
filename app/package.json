{
  "name": "invoice-generator",
  "version": "1.0.1",
  "description": "Local-first Windows invoice and thermal receipt generator",
  "main": "./out/main/index.js",
  "type": "module",
  "build": {
    "appId": "com.invoicegenerator.desktop",
    "productName": "Invoice Generator",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "node --test",
    "build": "electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@napi-rs/canvas": "1.2.1",
    "@tabler/icons-react": "^3.52.0",
    "electron-updater": "^6.0.0",
    "iconv-lite": "^0.7.3",
    "retail-print-kit": "0.4.0",
    "usb": "2.19.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
