{
  "name": "invoice-generator",
  "version": "1.0.0",
  "description": "Local-first Windows invoice and thermal receipt generator",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "node --test",
    "build": "electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win nsis portable"
  },
  "dependencies": {
    "@mantine/core": "^9.8.1",
    "@mantine/form": "^9.8.1",
    "@mantine/hooks": "^9.8.1",
    "@mantine/notifications": "^9.8.1",
    "@tabler/icons-react": "^3.52.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^3.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  }
}
