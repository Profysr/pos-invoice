{
  "name": "usps-shipping-receipt",
  "version": 1,
  "kind": "receipt",
  "blocks": [
    {
      "type": "newline",
      "count": 2
    },
    {
      "type": "image",
      "align": "center",
      "width": 384,
      "height": 96,
      "data": ""
    },
    {
      "type": "text",
      "value": "{{store.name}}",
      "align": "center"
    },
    {
      "type": "text",
      "value": "{{store.address}} {{store.city}}",
      "align": "center"
    },
    {
      "type": "text",
      "value": "{{store.state}} {{store.zip}}",
      "align": "center"
    },
    {
      "type": "text",
      "value": "{{store.contact}}",
      "align": "center"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "{{date}}",
          "width": 0.7
        },
        {
          "value": "{{time}}",
          "width": 0.3,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "line"
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "Product",
          "width": 0.5,
          "style": "b"
        },
        {
          "value": "Qty",
          "width": 0.15,
          "align": "CENTER",
          "style": "b"
        },
        {
          "value": "Unit Price",
          "width": 0.15,
          "align": "CENTER",
          "style": "b"
        },
        {
          "value": "Price",
          "width": 0.2,
          "align": "RIGHT",
          "style": "b"
        }
      ]
    },
    {
      "type": "line"
    },
    {
      "type": "table",
      "rows": "items",
      "columns": [
        {
          "value": "{{name}}",
          "width": 0.5,
          "style": "b"
        },
        {
          "value": "{{qty}}",
          "width": 0.15,
          "align": "CENTER"
        },
        {
          "value": "{{unitPrice}}",
          "width": 0.15,
          "align": "RIGHT"
        },
        {
          "value": "{{price}}",
          "width": 0.2,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "text",
      "value": "{{shipping.destination}}",
      "style": "normal",
      "align": "left"
    },
    {
      "type": "if",
      "when": "shipping.weight",
      "blocks": [
        {
          "type": "text",
          "value": "Weight: {{shipping.weight}}",
          "style": "normal",
          "align": "left"
        }
      ]
    },
    {
      "type": "text",
      "value": "Expected Delivery Date:"
    },
    {
      "type": "text",
      "value": "       {{shipping.expectedDelivery}}",
      "align": "left"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "text",
      "value": "Tracking #:",
      "style": "b"
    },
    {
      "type": "text",
      "value": "       {{shipping.trackingNumber}}",
      "align": "left"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "Up to $100.00 included",
          "width": 0.7,
          "align": "CENTER"
        },
        {
          "value": "$0.00",
          "width": 0.3,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "Total",
          "width": 0.7,
          "style": "b"
        },
        {
          "value": "{{total}}",
          "width": 0.3,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "line"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "Grand Total:",
          "width": 0.7,
          "style": "b"
        },
        {
          "value": "{{grandTotal}}",
          "width": 0.3,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "line"
    },
    {
      "type": "line"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "text",
      "value": "Text your tracking number to 28777 (2USPS)",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "to get the latest status.Standard Message",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "and Date Rates may apply.You may also",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "visit www.usps.com USPS Tracking or call",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "1-800-222-1811.",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "text",
      "value": "Save this receipt as evidence of",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "insurance. For information on filing an",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "insurance claim go to",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "https://www.usps.com/help/claims.htm",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "text",
      "value": "or call 1-800-222-1811.",
      "size": [1.1, 1.1],
      "align": "center"
    },
    {
      "type": "feed",
      "value": 3,
      "lines": 3
    },
    {
      "type": "cut",
      "feed": 5,
      "partial": false
    }
  ]
}
