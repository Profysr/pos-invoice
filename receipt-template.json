{
  "name": "shipping-receipt",
  "version": 1,
  "kind": "receipt",
  "blocks": [
    {
      "type": "each",
      "items": "shippingFromLines",
      "blocks": [
        {
          "type": "text",
          "value": "{{this}}",
          "align": "center"
        }
      ]
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "row",
      "cells": [
        {
          "value": "{{invoiceDate}}",
          "align": "LEFT",
          "width": 0.5
        },
        {
          "value": "{{invoiceTime}}",
          "align": "RIGHT",
          "width": 0.5
        }
      ]
    },
    {
      "type": "line",
      "char": "-"
    },
    {
      "type": "text",
      "value": "{{tableHeader}}",
      "style": "b",
      "size": [1, 1]
    },
    {
      "type": "line",
      "char": "-"
    },
    {
      "type": "table",
      "rows": "items",
      "header": false,
      "columns": [
        {
          "value": "{{product}}@",
          "header": "Product",
          "width": 0.46,
          "align": "LEFT"
        },
        {
          "value": "{{qty}}",
          "header": "Qty",
          "width": 0.12,
          "align": "RIGHT"
        },
        {
          "value": "{{unitPrice}}",
          "header": "Unit Price",
          "width": 0.18,
          "align": "RIGHT"
        },
        {
          "value": "{{price}}",
          "header": "Price",
          "width": 0.24,
          "align": "RIGHT"
        }
      ]
    },
    {
      "type": "if",
      "when": "destinationAddress",
      "blocks": [
        {
          "type": "text",
          "value": "  {{destinationAddress}}",
          "align": "left"
        }
      ],
      "else": []
    },
    {
      "type": "if",
      "when": "packageWeight",
      "blocks": [
        {
          "type": "text",
          "value": "  Weight: {{packageWeight}}",
          "align": "left"
        }
      ],
      "else": []
    },
    {
      "type": "text",
      "value": "Expected Delivery Date:",
      "align": "left"
    },
    {
      "type": "if",
      "when": "expectedDeliveryDate",
      "blocks": [
        {
          "type": "text",
          "value": "     {{expectedDeliveryDate}}",
          "align": "left"
        }
      ],
      "else": []
    },
    {
      "type": "text",
      "value": "Tracking #:",
      "align": "left",
      "style": "b"
    },
    {
      "type": "if",
      "when": "trackingNumber",
      "blocks": [
        {
          "type": "text",
          "value": "     {{trackingNumber}}",
          "align": "left"
        }
      ],
      "else": []
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "text",
      "value": "{{insuranceRow}}",
      "align": "left"
    },
    {
      "type": "text",
      "value": "{{totalRow}}",
      "align": "left"
    },
    {
      "type": "line",
      "char": "-"
    },
    {
      "type": "text",
      "value": "{{grandTotalRow}}",
      "align": "left",
      "style": "b"
    },
    {
      "type": "line",
      "char": "-"
    },
    {
      "type": "line",
      "char": "-"
    },
    {
      "type": "newline",
      "count": 1
    },
    {
      "type": "each",
      "items": "footerLines",
      "blocks": [
        {
          "type": "text",
          "value": "{{this}}",
          "align": "center"
        }
      ]
    },
    {
      "type": "cut",
      "partial": false,
      "feed": 3
    }
  ]
}
